{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "clockify-panel",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "exec \"$HOME/Library/Application Support/clockify-panel/launch.sh\""
      ],
      "port": 7878,
      "autoPort": true
    },
    {
      "name": "oracle-site",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "exec python3 -m http.server 8765 --directory \"$HOME/Documents/GitHub/Oracle-Solutions-Site/site\""
      ],
      "port": 8765
    },
    {
      "name": "oracle-mail-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "exec python3 -m http.server 8766 --bind 127.0.0.1 --directory \"$HOME/Documents/GitHub/Oracle-Solutions-Site\""
      ],
      "port": 8766
    }
  ]
}
