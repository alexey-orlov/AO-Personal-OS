{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "clockify-panel",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "exec \"$HOME/Library/Application Support/clockify-panel/launch.sh\""
      ],
      "port": 7878,
      "autoPort": true
    },
    {
      "name": "oracle-site",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "exec python3 \"$HOME/Documents/GitHub/Oracle-Solutions-Site/tools/serve.py\" 8765 \"$HOME/Documents/GitHub/Oracle-Solutions-Site/site\""
      ],
      "port": 8765
    },
    {
      "name": "oracle-site-alt",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "exec python3 \"$HOME/Documents/GitHub/Oracle-Solutions-Site/tools/serve.py\" \"${PORT:-8767}\" \"$HOME/Documents/GitHub/Oracle-Solutions-Site/site\""
      ],
      "port": 8767,
      "autoPort": true
    },
    {
      "name": "oracle-pack-artifacts",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "exec python3 -m http.server 8792 --bind 127.0.0.1 --directory \"$HOME/oracle-packs\""
      ],
      "port": 8792
    },
    {
      "name": "oracle-mail-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "exec python3 -m http.server 8766 --bind 127.0.0.1 --directory \"$HOME/Documents/GitHub/Oracle-Solutions-Site\""
      ],
      "port": 8766
    },
    {
      "name": "wc-rental-map",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "exec python3 -m http.server 8794 --bind 127.0.0.1 --directory \"${WC_MAP_SITE:-$HOME/Documents/GitHub/AO-Personal-OS/context/areas/relocation/docs/walnut-creek-map/site}\""
      ],
      "port": 8794
    },
    {
      "name": "klod-game",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "exec python3 -m http.server 8797 --bind 127.0.0.1 --directory \"/private/tmp/claude-502/-Users-olekorlov-Documents-GitHub-AO-Personal-OS/b0daf5ac-17f3-4844-af4b-ff79f863a251/scratchpad\""
      ],
      "port": 8797
    }
  ]
}
