{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "clockify-panel",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "exec \"$HOME/Library/Application Support/clockify-panel/launch.sh\""
      ],
      "port": 7878,
      "autoPort": true
    },
    {
      "name": "oracle-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "outputs/oracle-solutions-site/site"
      ],
      "port": 8765
    },
    {
      "name": "type-specimen",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--directory",
        "outputs/oracle-solutions-site/.work/specimen"
      ],
      "port": 8766
    }
  ]
}
